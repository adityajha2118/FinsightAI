# ──────────────────────────────────────────────────────────
# FinSight AI — Environment Variables Template
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env — it is in .gitignore
# ──────────────────────────────────────────────────────────

# ── LLM Provider Configuration ───────────────────────────
# Choose ONE provider: groq | gemini | openai
LLM_PROVIDER=groq

# Groq (free tier — recommended): https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Google Gemini: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza_your_key_here

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_key_here

# ── Database Configuration ───────────────────────────────
DATABASE_URL=postgresql://finsight:finsight@localhost:5432/finsight_db

# ── Application Settings ────────────────────────────────
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ── Deployment URLs ─────────────────────────────────────
# Backend URL (set in frontend after Railway deploy)
NEXT_PUBLIC_API_URL=https://your-app.railway.app
