# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ───────────────────────────────
.env
.env.local
.env.production
*.key

# ── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── RAW DATASETS — too large for GitHub ─────────────────
# These go to Google Drive (see data/README.md for download link)
data/raw/

# ── Allow processed outputs and features ─────────────────
# These are generated by notebooks and needed for deployment
!data/processed/
!data/processed/*.csv
!data/features/
!data/features/*.csv
!data/features/*.parquet

# ── Allow all model files ────────────────────────────────
!models/
!models/**
!models/**/*.pkl

# ── OS files ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────
*.log
logs/

# ── Compiled bytecode (uploaded .pyc files — remove) ─────
*.pyc
